# Copy this file to .env at the repo root. .env is not committed.
# Docker Compose and the Express server both read that file.

# Port the API listens on.
PORT=3001

# Postgres, used by docker-compose.yml.
# POSTGRES_PASSWORD is stored in the Docker volume on first startup.
# Changing it later has no effect until that volume is recreated.
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_database_name
# Host port mapped to Postgres inside the container (always 5432 there).
POSTGRES_PORT=5432
